<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.mb.mb-plugin</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
        <name>MBKarate For AutoTest</name>

    <vendor>Duy Van Thanh</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Productivity plugin for <b>Karate + Gherkin</b> workflows in IntelliJ IDEA.
        <br><br>
        Main capabilities:
        <ul>
            <li>Go to declaration for <code>call read(...)</code>, classpath/src paths, and related file references</li>
            <li>Smart completion for file/tag/short triggers (<code>#</code>, <code>!</code>, <code>&amp;</code>)</li>
            <li>Documentation hover for scenario doc blocks (<code>@short</code>, <code>@param</code>, <code>@return</code>, snippets)</li>
            <li>Validation for missing required input params in <code>call read(...)</code> and unresolved file paths</li>
            <li>Scenario Impact gutter + graph to inspect scenario reuse chains</li>
            <li>Custom Run/Debug generation via configurable Karate test runner templates</li>
            <li>Jira tag integration (gutter + intentions)</li>
            <li>cURL import to Karate feature format</li>
            <li>Examples table spreadsheet editor</li>
            <li>Karate Tree Explorer and Short Playbook tool windows</li>
        </ul>
        Built for MB Bank automation teams while staying compatible with standard Gherkin/Cucumber behavior.
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>org.intellij.intelliLang</depends>
    <depends>JUnit</depends>
    <depends optional="true" config-file="gherkin-integration.xml">gherkin</depends>
    
    <!-- File type handling -->
    <xi:include href="/META-INF/fileType.xml" xpointer="xpointer(/idea-plugin/*)"
        xmlns:xi="http://www.w3.org/2001/XInclude"/>

    <!-- Project Services -->
    <projectListeners>
        <listener class="com.mb.mbplugin.jira.JiraProjectListener"
                  topic="com.intellij.openapi.project.ProjectManagerListener"/>
    </projectListeners>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Core functionality that doesn't depend on Gherkin -->
        
        <!-- Go To Declaration Handler - Order first to handle file paths before Gherkin step definitions -->
        <gotoDeclarationHandler
                order="first"
                implementation="com.mb.mbplugin.karate.navigation.KarateGoToSymbolProvider"/>
        
        <!-- Feature File Index -->
        <fileBasedIndex implementation="com.mb.mbplugin.karate.index.KarateFeatureIndex"/>
        
        <!-- Karate Tree Explorer Tool Window -->
        <toolWindow id="Karate Tree Explorer"
                    anchor="right"
                    factoryClass="com.mb.mbplugin.karate.explorer.KarateTreeExplorerToolWindowFactory"
                    icon="AllIcons.FileTypes.Any_type"/>
        
        <!-- Short Playbook Tool Window -->
        <toolWindow id="Short Playbook"
                    anchor="right"
                    factoryClass="com.mb.mbplugin.karate.playbook.ShortPlaybookToolWindowFactory"
                    icon="AllIcons.Actions.ListFiles"/>
        
        <!-- Examples Table Editor Tool Window -->
        <toolWindow id="Examples Table Editor"
                    anchor="right"
                    factoryClass="com.mb.mbplugin.karate.examples.ExamplesTableEditorToolWindowFactory"
                    icon="AllIcons.Actions.Properties"/>
        
        <!-- Jira Integration Settings -->
        <projectConfigurable
                groupId="tools"
                displayName="Jira Integration"
                id="com.mb.mbplugin.settings.JiraSettingsConfigurable"
                implementation="com.mb.mbplugin.settings.JiraSettingsConfigurable"/>
        
        <!-- Karate Test Runner Settings -->
        <projectConfigurable
                groupId="tools"
                displayName="Karate Test Runner"
                id="com.mb.mbplugin.settings.KarateTestRunnerSettingsConfigurable"
                implementation="com.mb.mbplugin.settings.KarateTestRunnerSettingsConfigurable"/>
        
        <!-- Variable Suggestion Patterns Settings -->
        <projectConfigurable
                groupId="tools"
                displayName="Variable Suggestion Patterns"
                id="com.mb.mbplugin.settings.KarateVariableSuggestionSettingsConfigurable"
                implementation="com.mb.mbplugin.settings.KarateVariableSuggestionSettingsConfigurable"/>
        
        <!-- Jira Issue Intention Actions -->
        <intentionAction>
            <category>Jira Integration</category>
            <className>com.mb.mbplugin.jira.OpenJiraIssueIntention</className>
        </intentionAction>
        
        <intentionAction>
            <category>Jira Integration</category>
            <className>com.mb.mbplugin.jira.OpenMultipleJiraIssuesIntention</className>
        </intentionAction>

    </extensions>
    
    <!-- Actions (Removed Karate Tables formatter as we're using Gherkin plugin for formatting) -->
    <actions>
        <action id="com.mb.mbplugin.karate.actions.ImportCurlAction"
            class="com.mb.mbplugin.karate.actions.ImportCurlAction"
            text="Import cURL as Karate Feature"
            description="Convert a curl command into a Karate test">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        
        <!-- Karate Tree Explorer Action -->
        <action id="com.mb.mbplugin.karate.explorer.ShowKarateTreeExplorerAction"
            class="com.mb.mbplugin.karate.explorer.ShowKarateTreeExplorerAction"
            text="Karate Tree Explorer"
            description="Show the Karate feature tree structure with call read navigation">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        
        <!-- Document Helper Action -->
        <action id="com.mb.mbplugin.karate.actions.DocumentHelperAction"
            class="com.mb.mbplugin.karate.actions.DocumentHelperAction"
            text="Document Helper"
            description="Quickly create documentation for Karate scenarios">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        
        <!-- Toggle Variable Suggestion Action -->
        <action id="com.mb.mbplugin.karate.actions.ToggleVariableSuggestionAction"
            class="com.mb.mbplugin.karate.actions.ToggleVariableSuggestionAction"
            text="Enable Variable Suggestion"
            description="Toggle variable name autocomplete from def statements and call reads">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
